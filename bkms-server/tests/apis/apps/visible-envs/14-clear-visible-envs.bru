meta {
  name: 14-clear-visible-envs
  type: http
  seq: 14
}

put {
  url: {{serviceURL}}/apps/{{visEnvAppID}}/visible-envs
  body: json
  auth: inherit
}

body:json {
  {
    "visibleEnvNames": []
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  // F-001：空数组表示清空配置，之后按「未配置」处理
  test("should clear the visible env names", () => {
    expect(res.body.data.visibleEnvNames).to.deep.equal([]);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
