meta {
  name: 04-wrong-app-type
  type: http
  seq: 4
}

get {
  url: {{serviceURL}}/apps/{{envVarPrecheckTafAppID}}/envs/{{envVarPrecheckEnvName}}/trpc-deploys/precheck
  body: none
  auth: inherit
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  test("should reject a TAF app on the tRPC pre-check route", () => {
    expect(res.body.error).to.be.an("object");
    expect(res.body.error.code).to.equal("INVALID_REQUEST");
    expect(res.body.error.message).to.contain("invalid app type");
    expect(res.body.error.system).to.equal("bkms");
    expect(res.body.error.module).to.equal("bkms-server");
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
