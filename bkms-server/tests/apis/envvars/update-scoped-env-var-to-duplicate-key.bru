meta {
  name: update-scoped-env-var-to-duplicate-key
  type: http
  seq: 16
}

put {
  url: {{serviceURL}}/workspaces/{{envvarsWorkspaceID}}/scoped-env-vars/{{envScopedOrderEnvVarID}}
  body: json
  auth: inherit
}

body:json {
  {
    "key": "{{envScopedKey}}",
    "value": "{{envScopedOrderValue}}"
  }
}

assert {
  res.status: eq 409
  res.body: isJson
}

tests {
  test("should report the new conflicting key and the original scope when updating", () => {
    const error = res.body.error;

    expect(bru.getVar("envScopedKey")).to.not.equal(bru.getVar("envScopedOrderKey"));
    expect(error.code).to.equal("ALREADY_EXISTS");
    expect(error.details).to.have.length(1);
    expect(error.details[0].code).to.equal("SCOPED_ENV_VAR_KEY_CONFLICT");
    expect(error.details[0].extras).to.deep.equal({
      workspaceID: bru.getVar("envvarsWorkspaceID"),
      scopeType: "env",
      scopeValue: bru.getVar("envvarsEnvName"),
      key: bru.getVar("envScopedKey")
    });
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
